{
  "name": "robolab-studio",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js",
    "build": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "dist": "npm run build && electron-builder --windows",
    "dist:linux": "npm run build && electron-builder --linux deb tar.gz",
    "dist:all": "npm run build && electron-builder -w -l"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.109.0",
    "@tailwindcss/vite": "^4.3.2",
    "blockly": "^12.5.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.3",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-monaco-editor": "^1.1.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.robolab.studio",
    "productName": "RoboLab Studio",
    "executableName": "robolab-studio",
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/drivers",
        "to": "drivers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "RoboLab-Studio-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "RoboLab-Studio-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "RoboLab Studio - IoT & Robotics IDE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Akhmad-Fadhlan",
        "repo": "robolab",
        "releaseType": "release"
      }
    ]
  }
}
